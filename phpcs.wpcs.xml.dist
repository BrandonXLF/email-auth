<?xml version="1.0"?>
<ruleset name="email-auth-wpcs">
	<description>WordPress Coding Standards for plugin bootstrap PHP.</description>

	<file>email-auth.php</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.0"/>

	<rule ref="PHPCompatibilityWP">
		<!-- Deprecated in PHPCS 3.12; PHPCompatibility.Syntax.ForbiddenCallTimePassByReference covers this. -->
		<exclude name="Generic.Functions.CallTimePassByReference"/>
	</rule>

	<rule ref="WordPress">
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="EmailAuth"/>
				<element value="EAUTH"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="email-auth"/>
			</property>
		</properties>
	</rule>
</ruleset>
